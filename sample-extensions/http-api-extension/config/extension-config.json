{
  "extension_id":      "http-api-ext-001",
  "extension_name":    "http-api-metrics-collector",
  "extension_version": "0.1.0",

  "configuration": {
    "log_level": "DEBUG",
    "interval":  15,
    "timeout":   5,
    "endpoints": [
      {
        "id":              "demo-api-local",
        "url":             "host.containers.internal",
        "port":            18080,
        "credentials_ref": "demo.api.token",
        "interval":        15,
        "enabled":         true,
        "tags": {
          "service":     "demo-api",
          "environment": "local",
          "protocol":    "http"
        }
      }
    ]
  },

  "otlp": {
    "endpoint":    "host.containers.internal:4317",
    "protocol":    "grpc",
    "compression": "gzip",
    "interval":    15,
    "timeout":     10
  }
}
